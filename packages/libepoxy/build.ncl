let { Attrs, BuildSpec, Local, OutputData, OutputLib, Source, .. } = import "minimal.ncl" in
let base = import "../base/build.ncl" in
let meson = import "../meson/build.ncl" in
let ninja = import "../ninja/build.ncl" in
let pkgconf = import "../pkgconf/build.ncl" in
let python = import "../python/build.ncl" in
let toolchain = import "../toolchain/build.ncl" in

let glibc = import "../glibc/build.ncl" in
let mesa = import "../mesa/build.ncl" in

let version = "1.5.10" in
{
  name = "libepoxy",
  build_deps = [
    { file = "build.sh" } | Local,
    {
      url = "https://github.com/anholt/libepoxy/archive/refs/tags/%{version}.tar.gz",
      sha256 = "a7ced37f4102b745ac86d6a70a9da399cc139ff168ba6b8002b4d8d43c900c15",
      extract = true,
      strip_prefix = "libepoxy-%{version}",
    } | Source,
    base,
    meson,
    ninja,
    pkgconf,
    # The GL/EGL dispatch tables are generated by src/gen_dispatch.py at build time.
    python,
    toolchain,
  ],
  runtime_deps = [
    glibc,
    # epoxy dlopen()s libGL/libEGL rather than linking them, but it still needs
    # the headers at build time and a real GL to resolve against at runtime.
    mesa,
  ],

  cmd = "./build.sh",

  outputs = {
    libs = { glob = "usr/lib/libepoxy.so*" } | OutputLib,
    includes = { glob = "usr/include/**" } | OutputData,
    pkgconfigs = { glob = "usr/lib/pkgconfig/*.pc" } | OutputData,
  },

  attrs =
    {
      upstream_version = version,
      license_spdx = "MIT",
      repology_project = "libepoxy",
      source_provenance = {
        category = 'GithubRepo,
        owner = "anholt",
        repo = "libepoxy",
      },
    } | Attrs,
} | BuildSpec
