let { Attrs, BuildSpec, Local, OutputBin, OutputData, OutputLib, Source, .. } = import "minimal.ncl" in
let base = import "../base/build.ncl" in
let meson = import "../meson/build.ncl" in
let ninja = import "../ninja/build.ncl" in
let pkgconf = import "../pkgconf/build.ncl" in
let python = import "../python/build.ncl" in
let toolchain = import "../toolchain/build.ncl" in

let glibc = import "../glibc/build.ncl" in

let version = "1.13.7" in
{
  name = "libevdev",
  build_deps = [
    { file = "build.sh" } | Local,
    {
      # Upstream's own tarballs live at www.freedesktop.org/software/libevdev/,
      # but that host 403s the sandbox fetcher. The GitLab tag archive is the
      # same tree and already carries meson.build, so no autoreconf is needed.
      url = "https://gitlab.freedesktop.org/libevdev/libevdev/-/archive/libevdev-%{version}/libevdev-libevdev-%{version}.tar.gz",
      sha256 = "9294aaaff6829ab1581e6684f4c3ddc449fee563229e863353a4893f1a673f4b",
      extract = true,
      strip_prefix = "libevdev-libevdev-%{version}",
    } | Source,
    base,
    meson,
    ninja,
    pkgconf,
    # The event-code tables are generated by scripts under libevdev/.
    python,
    toolchain,
  ],
  runtime_deps = [glibc],

  cmd = "./build.sh",

  outputs = {
    bins = { glob = "usr/bin/libevdev-*" } | OutputBin,
    libs = { glob = "usr/lib/libevdev.so*" } | OutputLib,
    includes = { glob = "usr/include/**" } | OutputData,
    pkgconfigs = { glob = "usr/lib/pkgconfig/*.pc" } | OutputData,
    man = { glob = "usr/share/man/**" } | OutputData,
  },

  attrs =
    {
      upstream_version = version,
      license_spdx = "MIT",
      repology_project = "libevdev",
    } | Attrs,
} | BuildSpec
